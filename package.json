{
  "name": "dnd-statsheet-maker",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "node server/dev.mjs",
    "build": "tsc -b && vite build && node server/build-rules.mjs",
    "preview": "vite preview",
    "host": "node scripts/host-build.mjs && node server/launch.mjs",
    "release:windows": "npm run verify && node scripts/package-windows.mjs",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "verify": "npm run build && npm test && node --import ./tests/register.mjs --test tests/productionHost.smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
